{
  "openapi": "3.0.3",
  "info": {
    "title": "Color Matching API",
    "version": "v1",
    "description": "Vendored from viamin/color_matching GET /api/v1/openapi.json (viamin/color_matching#110, landed in #113) with the iOS client overlay from docs/openapi-generated-client-plan.md: stable operationIds and fully documented manifest/measurement/ranked-results payloads."
  },
  "servers": [{ "url": "/" }],
  "security": [{ "bearerAuth": [] }],
  "paths": {
    "/api/v1/test_sheets/{sheet_id}/manifest": {
      "get": {
        "operationId": "getTestSheetManifest",
        "tags": ["Test sheets"],
        "summary": "Fetch a test sheet manifest",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          {
            "name": "sheet_id",
            "in": "path",
            "required": true,
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": {
            "description": "Sheet manifest",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/TestSheetManifest" }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ApiErrorResponse" }
              }
            }
          },
          "404": {
            "description": "Test sheet not found",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ApiErrorResponse" }
              }
            }
          }
        }
      }
    },
    "/api/v1/test_sheets/recent": {
      "get": {
        "operationId": "listRecentTestSheets",
        "tags": ["Test sheets"],
        "summary": "List recent test sheets",
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": {
            "description": "Recent sheets",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/RecentSheetsResponse" }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ApiErrorResponse" }
              }
            }
          }
        }
      }
    },
    "/api/v1/test_sheets/{sheet_id}/ranked_results": {
      "get": {
        "operationId": "getRankedResults",
        "tags": ["Test sheets"],
        "summary": "Fetch ranked results for a test sheet",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          {
            "name": "sheet_id",
            "in": "path",
            "required": true,
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": {
            "description": "Ranked results",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/RankedResults" }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ApiErrorResponse" }
              }
            }
          },
          "404": {
            "description": "Test sheet not found",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ApiErrorResponse" }
              }
            }
          }
        }
      }
    },
    "/api/v1/test_sheets/{sheet_id}/captures": {
      "post": {
        "operationId": "createCapture",
        "tags": ["Captures"],
        "summary": "Create a capture for a test sheet",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          {
            "name": "sheet_id",
            "in": "path",
            "required": true,
            "schema": { "type": "string" }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/CaptureRequest" }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Capture created",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/CaptureCreatedResponse" }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ApiErrorResponse" }
              }
            }
          },
          "404": {
            "description": "Test sheet not found",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ApiErrorResponse" }
              }
            }
          },
          "422": {
            "description": "Invalid capture attributes",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ApiErrorResponse" }
              }
            }
          }
        }
      }
    },
    "/api/v1/captures/{capture_id}/measurements": {
      "post": {
        "operationId": "uploadMeasurements",
        "tags": ["Captures"],
        "summary": "Upload capture measurements",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          {
            "name": "capture_id",
            "in": "path",
            "required": true,
            "schema": { "type": "string" }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/MeasurementUploadRequest" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Measurements accepted",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/MeasurementUploadResponse" }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ApiErrorResponse" }
              }
            }
          },
          "404": {
            "description": "Capture not found",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ApiErrorResponse" }
              }
            }
          },
          "422": {
            "description": "Invalid measurement upload",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ApiErrorResponse" }
              }
            }
          }
        }
      }
    },
    "/api/v1/captures/{capture_id}/judgments": {
      "post": {
        "operationId": "uploadJudgments",
        "tags": ["Captures"],
        "summary": "Upload capture judgments",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          {
            "name": "capture_id",
            "in": "path",
            "required": true,
            "schema": { "type": "string" }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/JudgmentUploadRequest" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Judgments accepted",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/JudgmentUploadResponse" }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ApiErrorResponse" }
              }
            }
          },
          "404": {
            "description": "Capture not found",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ApiErrorResponse" }
              }
            }
          },
          "422": {
            "description": "Invalid judgment upload",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ApiErrorResponse" }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "API token"
      }
    },
    "schemas": {
      "TestSheetManifest": {
        "type": "object",
        "description": "Versioned sheet manifest consumed by the iOS companion application (schema lps-sheet-manifest/v1).",
        "required": [
          "schema_version",
          "sheet_id",
          "sheet_version",
          "manifest_url",
          "page",
          "registration_markers",
          "printer_profile",
          "capture_profile",
          "patches",
          "pairs"
        ],
        "properties": {
          "schema_version": {
            "type": "string",
            "enum": ["lps-sheet-manifest/v1"],
            "description": "Manifest compatibility version."
          },
          "sheet_id": { "type": "string" },
          "sheet_version": { "type": "string" },
          "manifest_url": { "type": "string" },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "page": {
            "type": "object",
            "required": ["units", "width", "height"],
            "properties": {
              "units": { "type": "string" },
              "width": { "type": "number" },
              "height": { "type": "number" }
            }
          },
          "registration_markers": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["role", "shape", "rect"],
              "properties": {
                "role": { "type": "string" },
                "shape": { "type": "string" },
                "rect": {
                  "type": "object",
                  "required": ["x", "y", "width", "height"],
                  "properties": {
                    "x": { "type": "number" },
                    "y": { "type": "number" },
                    "width": { "type": "number" },
                    "height": { "type": "number" }
                  }
                }
              }
            }
          },
          "printer_profile": {
            "type": "object",
            "description": "Shape rendered by ColorMatchingWeb.TestSheetJSON.render_printer_profile/1.",
            "required": ["printer_make_model", "paper_type", "ink_type"],
            "properties": {
              "printer_make_model": { "type": "string" },
              "paper_type": { "type": "string" },
              "ink_type": { "type": "string" },
              "icc_profile": { "type": "string", "nullable": true },
              "print_settings": { "type": "string", "nullable": true },
              "driver_name": { "type": "string", "nullable": true },
              "driver_version": { "type": "string", "nullable": true },
              "calibration_date": { "type": "string", "nullable": true },
              "calibration_version": { "type": "string", "nullable": true },
              "notes": { "type": "string", "nullable": true }
            }
          },
          "capture_profile": {
            "type": "object",
            "required": [
              "expected_illuminant",
              "preferred_camera",
              "scoring_algorithm_version"
            ],
            "properties": {
              "expected_illuminant": { "type": "string" },
              "preferred_camera": { "type": "string" },
              "scoring_algorithm_version": {
                "type": "string",
                "enum": ["lps-distance-v1"],
                "description": "Distance-scoring compatibility version."
              }
            }
          },
          "patches": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["id", "role", "safe_inset_mm", "rect"],
              "properties": {
                "id": { "type": "string" },
                "role": { "type": "string" },
                "pair_id": { "type": "string", "nullable": true },
                "pair_side": { "type": "string", "nullable": true },
                "reference_role": { "type": "string", "nullable": true },
                "source_color": { "type": "string", "nullable": true },
                "safe_inset_mm": { "type": "number" },
                "rect": {
                  "type": "object",
                  "required": ["x", "y", "width", "height"],
                  "properties": {
                    "x": { "type": "number" },
                    "y": { "type": "number" },
                    "width": { "type": "number" },
                    "height": { "type": "number" }
                  }
                }
              }
            }
          },
          "pairs": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "id",
                "first_patch_id",
                "second_patch_id",
                "source_colors",
                "grid_row",
                "grid_col"
              ],
              "properties": {
                "id": { "type": "string" },
                "first_patch_id": { "type": "string" },
                "second_patch_id": { "type": "string" },
                "source_colors": {
                  "type": "array",
                  "items": { "type": "string" }
                },
                "grid_row": { "type": "integer" },
                "grid_col": { "type": "integer" }
              }
            }
          }
        }
      },
      "RecentSheetsResponse": {
        "type": "object",
        "required": ["sheets"],
        "properties": {
          "sheets": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["sheet_id", "manifest_url", "title"],
              "properties": {
                "sheet_id": { "type": "string" },
                "manifest_url": { "type": "string" },
                "title": { "type": "string", "nullable": true }
              }
            }
          }
        }
      },
      "RankedResults": {
        "type": "object",
        "description": "Aggregate ranked results for a test sheet (schema lps-ranked-results/v1).",
        "required": ["schema_version", "sheet_id", "results"],
        "properties": {
          "schema_version": {
            "type": "string",
            "enum": ["lps-ranked-results/v1"]
          },
          "sheet_id": { "type": "string" },
          "printer_profile": {
            "type": "object",
            "required": ["printer_make_model", "paper_type", "ink_type"],
            "properties": {
              "printer_make_model": { "type": "string" },
              "paper_type": { "type": "string" },
              "ink_type": { "type": "string" }
            },
            "nullable": true
          },
          "capture_count": { "type": "integer", "nullable": true },
          "latest_capture_at": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "earliest_capture_at": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "scoring_algorithm_versions": {
            "type": "array",
            "items": { "type": "string" },
            "nullable": true
          },
          "results": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["rank", "pair_id", "source_colors", "score"],
              "properties": {
                "rank": { "type": "integer" },
                "pair_id": { "type": "string" },
                "scoring_algorithm_version": { "type": "string", "nullable": true },
                "row": { "type": "integer", "nullable": true },
                "col": { "type": "integer", "nullable": true },
                "source_colors": {
                  "type": "object",
                  "required": ["color_a_hex", "color_b_hex"],
                  "properties": {
                    "color_a_hex": { "type": "string" },
                    "color_b_hex": { "type": "string" }
                  }
                },
                "score": {
                  "type": "object",
                  "properties": {
                    "average": { "type": "number", "nullable": true },
                    "latest": { "type": "number", "nullable": true },
                    "minimum": { "type": "number", "nullable": true },
                    "maximum": { "type": "number", "nullable": true },
                    "capture_count": { "type": "integer", "nullable": true },
                    "sample_count": { "type": "integer", "nullable": true },
                    "algorithm_versions": {
                      "type": "array",
                      "items": { "type": "string" },
                      "nullable": true
                    }
                  }
                },
                "current_judgment": { "type": "string", "nullable": true },
                "current_judgment_observed_at": {
                  "type": "string",
                  "format": "date-time",
                  "nullable": true
                },
                "observation_count": { "type": "integer", "nullable": true },
                "latest_observation": {
                  "type": "object",
                  "required": ["judgment", "observed_at"],
                  "properties": {
                    "judgment": { "type": "string" },
                    "observed_at": { "type": "string", "format": "date-time" }
                  },
                  "nullable": true
                },
                "capture_count": { "type": "integer", "nullable": true },
                "latest_capture_at": {
                  "type": "string",
                  "format": "date-time",
                  "nullable": true
                },
                "earliest_capture_at": {
                  "type": "string",
                  "format": "date-time",
                  "nullable": true
                }
              }
            }
          }
        }
      },
      "CaptureRequest": {
        "type": "object",
        "description": "The nested {metadata, quality} form posted by the iOS companion app; the server also accepts a flattened form.",
        "required": ["metadata", "quality"],
        "properties": {
          "metadata": { "$ref": "#/components/schemas/CaptureMetadata" },
          "quality": {
            "type": "object",
            "required": ["detected_marker_count", "blur_score", "rejections"],
            "properties": {
              "detected_marker_count": { "type": "integer", "minimum": 0 },
              "blur_score": { "type": "number", "minimum": 0 },
              "rejections": {
                "type": "array",
                "items": { "type": "string" }
              }
            }
          }
        }
      },
      "CaptureMetadata": {
        "type": "object",
        "required": [
          "device_model",
          "lens",
          "image_width",
          "image_height",
          "app_version",
          "timestamp"
        ],
        "properties": {
          "device_model": { "type": "string" },
          "lens": { "type": "string" },
          "exposure_duration_seconds": {
            "type": "number",
            "minimum": 0,
            "exclusiveMinimum": true
          },
          "iso": { "type": "integer", "minimum": 0, "exclusiveMinimum": true },
          "focus_lens_position": { "type": "number", "minimum": 0 },
          "white_balance_gains": {
            "type": "object",
            "required": ["red", "green", "blue"],
            "properties": {
              "red": { "type": "number" },
              "green": { "type": "number" },
              "blue": { "type": "number" }
            }
          },
          "image_width": { "type": "integer", "minimum": 0, "exclusiveMinimum": true },
          "image_height": { "type": "integer", "minimum": 0, "exclusiveMinimum": true },
          "app_version": { "type": "string" },
          "timestamp": { "type": "string", "format": "date-time" }
        }
      },
      "CaptureCreatedResponse": {
        "type": "object",
        "required": ["capture_id"],
        "properties": {
          "capture_id": { "type": "string" }
        }
      },
      "MeasurementUploadRequest": {
        "type": "object",
        "required": ["scoring_algorithm_version", "measurements", "pair_scores"],
        "properties": {
          "scoring_algorithm_version": { "type": "string" },
          "measurements": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "patch_id",
                "linear_rgb_median",
                "normalized_linear_rgb_median",
                "stats"
              ],
              "properties": {
                "patch_id": { "type": "string" },
                "linear_rgb_median": {
                  "type": "object",
                  "required": ["r", "g", "b"],
                  "properties": {
                    "r": { "type": "number" },
                    "g": { "type": "number" },
                    "b": { "type": "number" }
                  }
                },
                "normalized_linear_rgb_median": {
                  "type": "object",
                  "required": ["r", "g", "b"],
                  "properties": {
                    "r": { "type": "number" },
                    "g": { "type": "number" },
                    "b": { "type": "number" }
                  }
                },
                "stats": {
                  "type": "object",
                  "required": [
                    "sample_count",
                    "clipping_fraction",
                    "mean",
                    "standard_deviation"
                  ],
                  "properties": {
                    "sample_count": { "type": "integer" },
                    "clipping_fraction": { "type": "number" },
                    "mean": {
                      "type": "object",
                      "required": ["r", "g", "b"],
                      "properties": {
                        "r": { "type": "number" },
                        "g": { "type": "number" },
                        "b": { "type": "number" }
                      }
                    },
                    "standard_deviation": {
                      "type": "object",
                      "required": ["r", "g", "b"],
                      "properties": {
                        "r": { "type": "number" },
                        "g": { "type": "number" },
                        "b": { "type": "number" }
                      }
                    }
                  }
                }
              }
            }
          },
          "pair_scores": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "pair_id",
                "distance",
                "similarity",
                "algorithm_version"
              ],
              "properties": {
                "pair_id": { "type": "string" },
                "distance": { "type": "number" },
                "similarity": { "type": "number" },
                "algorithm_version": { "type": "string" }
              }
            }
          }
        }
      },
      "MeasurementUploadResponse": {
        "type": "object",
        "required": ["capture_id", "measurement_count", "pair_score_count"],
        "properties": {
          "capture_id": { "type": "string" },
          "measurement_count": { "type": "integer" },
          "pair_score_count": { "type": "integer" }
        }
      },
      "JudgmentUploadRequest": {
        "type": "object",
        "required": ["judgments"],
        "properties": {
          "judgments": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["pair_id", "judgment"],
              "properties": {
                "pair_id": { "type": "string" },
                "judgment": { "type": "string" }
              }
            }
          }
        }
      },
      "JudgmentUploadResponse": {
        "type": "object",
        "required": ["capture_id", "judgment_count"],
        "properties": {
          "capture_id": { "type": "string" },
          "judgment_count": { "type": "integer" }
        }
      },
      "ApiErrorResponse": {
        "type": "object",
        "required": ["errors"],
        "properties": {
          "errors": {
            "type": "object",
            "additionalProperties": true
          }
        }
      }
    }
  }
}
