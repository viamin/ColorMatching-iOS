    "/api/multi_image_mapping": {
      "post": {
        "tags": [
          "Image mapping"
        ],
        "summary": "Map grayscale images to a palette-colored PNG",
        "operationId": "ColorMatchingWeb.MultiImageMappingController.create",
        "requestBody": {
          "content": {
