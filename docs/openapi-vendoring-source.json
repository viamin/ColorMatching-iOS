  "components": {
    "schemas": {
      "TestSheetManifest": {
        "type": "object",
        "description": "Versioned sheet manifest consumed by the iOS companion application.",
        "properties": {
          "schema_version": {
            "type": "string",
            "enum": [
              "lps-sheet-manifest/v1"
            ],
            "description": "Manifest compatibility version."
          },
          "sheet_id": {
            "type": "string"
          },
          "capture_profile": {
            "type": "object",
            "properties": {
              "scoring_algorithm_version": {
                "type": "string",
                "enum": [
                  "lps-distance-v1"
                ],
                "description": "Distance-scoring compatibility version."
              }
            },
            "required": [
              "scoring_algorithm_version"
            ]
          }
        },
        "required": [
          "schema_version",
          "sheet_id",
          "capture_profile"
        ]
      },
      "RankedResults": {
        "type": "object",
        "properties": {
          "schema_version": {
            "type": "string",
            "enum": [
              "lps-ranked-results/v1"
            ]
          },
          "sheet_id": {
            "type": "string"
          }
        },
        "required": [
          "schema_version",
          "sheet_id"
        ]
      },
      "MultiImageMappingRequest": {
        "type": "object",
        "required": [
          "palette_id",
          "printer_profile_id",
          "weights",
          "images"
        ],
        "properties": {
          "palette_id": {
            "type": "integer",
            "minimum": 1
          },
          "printer_profile_id": {
            "type": "integer",
            "minimum": 1
          },
          "weights": {
            "type": "object",
            "additionalProperties": {
              "type": "number"
            }
          },
          "images": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          }
        }
      },
      "ApiErrorResponse": {
        "type": "object",
        "properties": {
          "errors": {
            "oneOf": [
              {
                "type": "object",
                "additionalProperties": true
              },
              {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "detail": {
                      "type": "string"
                    },
                    "source": {
                      "type": "object",
                      "properties": {
                        "pointer": {
                          "type": "string"
                        }
                      },
                      "required": [
                        "pointer"
                      ]
                    }
                  },
                  "required": [
                    "detail",
                    "source"
                  ]
                }
              }
            ]
          }
        },
        "required": [
          "errors"
        ]
      },
      "PrinterProfile": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer"
          },
          "printer_make_model": {
            "type": "string"
          },
          "paper_type": {
            "type": "string"
          },
          "ink_type": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "printer_make_model",
          "paper_type",
          "ink_type"
        ]
      },
      "Rgb": {
        "type": "object",
        "properties": {
          "r": {
            "type": "integer"
          },
          "g": {
            "type": "integer"
          },
          "b": {
            "type": "integer"
          }
        },
        "required": [
          "r",
          "g",
          "b"
        ]
      },
      "PrinterProfilesResponse": {
        "type": "object",
        "properties": {
          "printer_profiles": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/PrinterProfile"
            }
          }
        },
        "required": [
          "printer_profiles"
        ]
      },
      "PalettesResponse": {
        "type": "object",
        "properties": {
          "palettes": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "integer"
                },
                "name": {
                  "type": "string"
                },
                "is_preset": {
                  "type": "boolean"
                },
                "color_count": {
                  "type": "integer"
                }
              },
              "required": [
                "id",
                "name",
                "is_preset",
                "color_count"
              ]
            }
          }
        },
        "required": [
          "palettes"
        ]
      },
      "ProfileColorsResponse": {
        "type": "object",
        "properties": {
          "printer_profile": {
            "$ref": "#/components/schemas/PrinterProfile"
          },
          "colors": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string"
                },
                "hex": {
                  "type": "string"
                },
                "rgb": {
                  "$ref": "#/components/schemas/Rgb"
                },
                "responses": {
                  "type": "object",
                  "additionalProperties": true
                }
              },
              "required": [
                "name",
                "hex",
                "responses"
              ]
            }
          }
        },
        "required": [
          "printer_profile",
          "colors"
        ]
